rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student profiles
    match /estudantes/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User library (favorites, to-read, finished)
    match /user_library/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    // Book and document catalog
    match /livros/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
    
    // Student matriculas for 9-digit student ID verification and fast sign-in
    match /matriculas/{matId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin roles
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // App configurations and design settings
    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Support and student assistance messages
    match /mensagens_suporte/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Covers for curriculum chairs/disciplines (per-subject documents to avoid size limits)
    match /cadeira_covers/{coverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Custom curriculum chairs / disciplines created or modified by admin
    match /cadeiras/{cadeiraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Collaborative virtual study rooms (Salas de Estudo em Grupo)
    match /salas_estudo/{salaId} {
      allow read, write: if true;

      match /mensagens/{messageId} {
        allow read, write: if true;
      }
    }

    // Connection health check
    match /test/{docId} {
      allow read: if true;
    }
  }
}

